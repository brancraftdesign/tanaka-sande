---
import '../styles/global.css';
interface Props { title: string; description: string; page?: 'home' | 'file'; image?: string }
const { title, description, page = 'home', image = '/img/fig-a05-record-run.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const home = page === 'home';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0F1011" />
  <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/martian-mono-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23111213'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%23FF5B1A'/%3E%3C/svg%3E" />
</head>
<body>
  <div class="frame">
    <header class="hud">
      <a class="wm" href="/">TANAKA SANDE</a>
      <nav aria-label="Main">
        <ul>
          <li><a href={home ? '#index' : '/#index'}>Index</a></li>
          <li><a href={home ? '#about' : '/#about'}>About</a></li>
          <li><a href={home ? '#contact' : '/#contact'}>Contact</a></li>
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot ro">
      <span>© 2026 Tanaka Sande</span>
      <span aria-hidden="true">17.83°S 31.05°E · <span data-clock>HRE</span></span>
    </footer>
  </div>
  <script is:inline>
    (function () {
      var el = document.querySelector('[data-clock]');
      if (!el) return;
      var f;
      try { f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Harare', hour: '2-digit', minute: '2-digit', hour12: false }); } catch (e) { return; }
      function tick() { el.textContent = 'HRE ' + f.format(new Date()); }
      tick(); setInterval(tick, 15000);
    })();
  </script>
  <script is:inline src="/motion.js" defer></script>
</body>
</html>
