---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const items = (await getCollection('work')).filter(e => e.data.status === 'live');
  return items.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={`${d.title} · Tanaka Sande`} description={d.summary} page="file" image={d.cover}>
  <header class="file-head">
    <a class="ro back" href="/#index">← Index</a>
    <h1 id="t">{d.title}</h1>
    <p class="ro specline"><span>{d.code}</span><span>{d.client}</span><span>{d.year}</span><span>{d.discipline}</span></p>
  </header>
  <article class="file-body"><Content /></article>
  <a class="next ro" href="/#index"><span>← Index</span></a>
</Base>
