---
import Base from '../layouts/Base.astro';
import Sec from '../components/Sec.astro';
import Archive from '../components/Archive.astro';
import ObjectStudy from '../components/ObjectStudy.astro';
---
<Base title="Tanaka Sande" description="Tanaka Sande is a product designer working across objects, brands and graphics. Harare, Zimbabwe. Open to remote work.">
  <section class="hero" aria-labelledby="who">
    <div>
      <h1 id="who">Product designer. <span>Objects, brands and the graphics that hold them together.</span></h1>
      <p class="ro status"><span class="dot" aria-hidden="true"></span>Open to remote work · Harare, UTC+2</p>
    </div>
    <ObjectStudy />
  </section>

  <Sec title="Index" id="index">
    <Archive />
  </Sec>

  <Sec title="About" id="about">
    <div class="prose" style="display:flex;flex-direction:column;gap:18px">
      <p style="color:var(--fg-2)">I've been redesigning the objects around me for as long as I can remember. I trained in product design at Ningbo University in China, and work from Harare across furniture, consumer products, brands, packaging and apparel.</p>
      <p style="color:var(--fg-2)">I lead the brands of a group of businesses in Harare, and run <a href="https://anti-formula.com" rel="noopener">Anti-Formula</a>, my studio for objects.</p>
    </div>
  </Sec>

  <Sec title="Contact" id="contact">
    <dl class="contact">
      <dt>Email</dt><dd><a href="mailto:sandetanaka@gmail.com">sandetanaka@gmail.com</a></dd>
      <dt>Phone</dt><dd>+263 71 326 4354</dd>
    </dl>
  </Sec>
</Base>
