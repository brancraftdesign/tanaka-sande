---
// A turned object drawn as a wireframe, slowly revolving: the home page's
// quiet reminder that this is a product designer's archive.
---
<figure class="obj" data-obj aria-label="Wireframe study of a turned vessel, 140 mm across and 260 mm tall, slowly revolving.">
  <canvas aria-hidden="true"></canvas>
  <span class="tag tl">Fig. 000 · Vessel study</span>
  <span class="tag tr">Ø 140 · H 260 mm</span>
  <span class="tag bl">Lathe profile · 28 seg</span>
  <span class="tag br" data-theta>θ 000.0°</span>
</figure>
<script is:inline>
(function () {
  var fig = document.querySelector('[data-obj]');
  if (!fig) return;
  var cv = fig.querySelector('canvas'), ctx = cv.getContext('2d'), th = fig.querySelector('[data-theta]');
  var css = getComputedStyle(document.documentElement);
  var LINE = css.getPropertyValue('--fg').trim() || '#E6E4DF';
  var SIG = css.getPropertyValue('--signal').trim() || '#FF5B1A';
  var DIM = css.getPropertyValue('--fg-3').trim() || '#75736E';
  // profile: [radius, height] in mm, base at 0
  var P = [[0,0],[50,0],[57,8],[64,48],[70,110],[66,150],[54,186],[36,214],[27,236],[30,252],[36,260]];
  var SEG = 28;
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W, H, dpr;
  function size() {
    dpr = Math.min(2, window.devicePixelRatio || 1);
    var r = fig.getBoundingClientRect(); W = r.width; H = r.height;
    cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function proj(x, y, z, a, s, cx, cy) {
    var ca = Math.cos(a), sa = Math.sin(a);
    var X = x * ca + z * sa, Z = -x * sa + z * ca;
    var tilt = 0.32, ct = Math.cos(tilt), st = Math.sin(tilt);
    var Y = (y - 130) * ct - Z * st, Z2 = (y - 130) * st + Z * ct;
    var f = 900 / (900 + Z2);
    return [cx + X * s * f, cy - Y * s * f, Z2];
  }
  function draw(a) {
    ctx.clearRect(0, 0, W, H);
    var s = Math.min(W, H) / 360, cx = W * 0.52, cy = H * 0.52;
    ctx.lineWidth = 1;
    // meridians
    for (var k = 0; k < SEG; k++) {
      var phi = (k / SEG) * Math.PI * 2, front = 0;
      ctx.beginPath();
      for (var i = 0; i < P.length; i++) {
        var r = P[i][0], p = proj(r * Math.cos(phi), P[i][1], r * Math.sin(phi), a, s, cx, cy);
        front += p[2];
        if (i) ctx.lineTo(p[0], p[1]); else ctx.moveTo(p[0], p[1]);
      }
      var back = front / P.length > 0;
      ctx.strokeStyle = k === 0 ? SIG : LINE;
      ctx.globalAlpha = k === 0 ? 0.95 : (back ? 0.12 : 0.42);
      ctx.stroke();
    }
    // parallels
    for (var j = 1; j < P.length; j++) {
      var rr = P[j][0];
      ctx.beginPath();
      for (var m = 0; m <= 64; m++) {
        var ph = (m / 64) * Math.PI * 2, q = proj(rr * Math.cos(ph), P[j][1], rr * Math.sin(ph), a, s, cx, cy);
        if (m) ctx.lineTo(q[0], q[1]); else ctx.moveTo(q[0], q[1]);
      }
      ctx.strokeStyle = LINE; ctx.globalAlpha = j === P.length - 1 ? 0.6 : 0.22; ctx.stroke();
    }
    // dimension: height bracket
    ctx.globalAlpha = 0.9; ctx.strokeStyle = DIM;
    var top = proj(0, 260, 0, 0, s, cx, cy), bot = proj(0, 0, 0, 0, s, cx, cy), x0 = cx - 118 * s;
    ctx.beginPath();
    ctx.moveTo(x0, top[1]); ctx.lineTo(x0, bot[1]);
    ctx.moveTo(x0 - 5, top[1]); ctx.lineTo(x0 + 5, top[1]);
    ctx.moveTo(x0 - 5, bot[1]); ctx.lineTo(x0 + 5, bot[1]);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }
  var a = 0.6, last = 0, vis = true;
  function tick(now) {
    var dt = last ? Math.min(0.1, (now - last) / 1000) : 0; last = now;
    if (vis) { a += dt * 0.22; draw(a); if (th) th.textContent = 'θ ' + ((a * 180 / Math.PI) % 360).toFixed(1).padStart(5, '0') + '°'; }
    requestAnimationFrame(tick);
  }
  size(); draw(a);
  window.addEventListener('resize', function () { size(); draw(a); });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { vis = e[0].isIntersecting; }).observe(fig);
  if (!reduce) requestAnimationFrame(tick);
})();
</script>
