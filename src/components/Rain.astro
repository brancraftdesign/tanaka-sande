---
import { wordmark } from '../lib/revere-svg';
---
<div class="motion m-rain" data-motion="rain" role="img" aria-label="Motion piece: a nine by nine grid of dots pulses in nine-eight time, grouped two, two, two, three, until one dot runs down like rain on glass.">
  <svg class="r-grid" viewBox="0 0 800 800" aria-hidden="true"></svg>
  <div class="r-lab" aria-hidden="true">rain on glass</div>
  <div class="r-count" aria-hidden="true">bar 1 · 2+2+2+3</div>
  <div class="r-word" aria-hidden="true"><Fragment set:html={wordmark('#F2EDE4')} /></div>
</div>
