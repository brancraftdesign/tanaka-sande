---
import { walkhome, wordmark } from '../lib/revere-svg';
---
<div class="motion m-walk" data-motion="walkhome" role="img" aria-label="Motion piece: a figure in a long coat is drawn line by line, then tobacco and slate colour lands slightly off-register.">
  <svg class="wh" viewBox="0 0 800 1000" aria-hidden="true"><Fragment set:html={walkhome()} /></svg>
  <div class="w-lab" aria-hidden="true">REV–A01 · walk home</div>
  <div class="w-word" aria-hidden="true"><Fragment set:html={wordmark('#222526')} /></div>
  <div class="w-veil" aria-hidden="true"></div>
</div>
