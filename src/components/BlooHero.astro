---
import raw from '../assets/svg/bloo-wordmark.svg?raw';
const W = Number(raw.match(/viewBox="0 0 ([\d.]+) 1000"/)?.[1] ?? 2041);
const inner = raw.replace(/^<svg[^>]*>/, '').replace(/<\/svg>$/, '');
// wordmark 760 px wide in a 1920 × 1080 frame
const s = 760 / W, x = (1920 - 760) / 2, y = 500 - (1000 * s) / 2;
const letters = inner;
---
<figure class="bloo-hero">
  <div class="motion m-bloo" data-motion="bloo" role="img" aria-label="BLOO logo animation: like a camera hunting for focus, the wordmark racks in and out of focus while the focus ring slides and stutters, then it locks sharp and the line Focus, by design. appears.">
    <svg viewBox="0 0 1920 1080" aria-hidden="true">
      <defs>
        <filter id="bfocus" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur class="b-blur" stdDeviation="0" /></filter>
        <linearGradient id="bfade" x1="0" x2="1"><stop offset="0" stop-color="#000" /><stop offset=".3" stop-color="#fff" /><stop offset=".7" stop-color="#fff" /><stop offset="1" stop-color="#000" /></linearGradient>
        <mask id="bring" maskUnits="userSpaceOnUse" x="600" y="930" width="720" height="120"><rect x="600" y="930" width="720" height="120" fill="url(#bfade)" /></mask>
      </defs>
      <rect width="1920" height="1080" fill="#004777" />
      <g class="b-word"><g filter="url(#bfocus)"><g transform={`translate(${x.toFixed(2)} ${y.toFixed(2)}) scale(${s.toFixed(5)})`} fill="#FAF9F3" set:html={letters} /></g></g>
      <g class="b-brackets" fill="none" stroke="#FAF9F3" stroke-width="2" stroke-linecap="square" style="opacity:0">
        <path d="M520 306V262H564M1356 262H1400V306M1400 694V738H1356M564 738H520V694" />
      </g>
      <g class="b-af" fill="#FAF9F3" font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="22" letter-spacing="3" style="opacity:0">
        <circle class="b-afdot" cx="96" cy="88" r="6" />
        <text x="114" y="96">AF</text>
      </g>
      <g class="b-ring" style="opacity:0">
        <g mask="url(#bring)">
          <g class="b-strip" stroke="#FAF9F3" stroke-width="1.5" fill="#FAF9F3" font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="18" letter-spacing="1">
<line x1="50" y1="960" x2="50" y2="988" />
<text x="50" y="1022" text-anchor="middle" stroke="none">0.3</text>
