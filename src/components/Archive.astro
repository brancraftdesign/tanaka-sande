---
import { getCollection } from 'astro:content';
const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<ul class="idx" data-idx>
  {items.map(({ id, data }) => (
    <li class={data.status} data-cover={data.cover}>
      {data.status === 'live' ? (
        <a class="row" href={`/work/${id}/`}>
          <span class="code">{data.code}</span><span class="ttl">{data.title}</span><span class="meta">{data.discipline}</span><span class="yr">{data.year}</span>
        </a>
      ) : (
        <div class="row" aria-label={`${data.title}, coming soon`}>
          <span class="code">{data.code}</span><span class="ttl">{data.title}</span><span class="meta">Soon</span><span class="yr">{data.year}</span>
        </div>
      )}
    </li>
  ))}
</ul>
<div class="peek" data-peek aria-hidden="true"><img alt="" /></div>
<script is:inline>
(function () {
  var t = document.querySelector('[data-idx]'), pk = document.querySelector('[data-peek]');
  if (!t || !pk || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  var img = pk.querySelector('img');
  t.querySelectorAll('li[data-cover]').forEach(function (li) {
    var src = li.getAttribute('data-cover'); if (!src) return;
    li.addEventListener('mouseenter', function () { img.src = src; pk.classList.add('on'); });
    li.addEventListener('mouseleave', function () { pk.classList.remove('on'); });
    li.addEventListener('mousemove', function (e) { pk.style.left = (e.clientX + 150) + 'px'; pk.style.top = e.clientY + 'px'; });
  });
})();
</script>
