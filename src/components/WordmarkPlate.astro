---
import { wordmark } from '../lib/revere-svg';
---
<figure class="plate plate-word" role="img" aria-label="REVERE wordmark with its clear-space construction, shown onyx on ivory and ivory on onyx.">
  <span class="tg">wordmark · clear space = x</span>
  <div class="cs"></div><div class="cs2"></div>
  <div class="wmk"><Fragment set:html={wordmark('#222526')} /></div>
  <div class="xh"></div><span class="x" style="left:12.6%;top:30.4%">x</span>
  <div class="xv"></div><span class="x" style="left:50.4%;top:23.4%">x</span>
  <div class="duo"><div class="lt"><Fragment set:html={wordmark('#222526')} /></div><div class="dk"><Fragment set:html={wordmark('#F2EDE4')} /></div></div>
</figure>
